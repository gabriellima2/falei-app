{
  "expo": {
    "name": "Falei",
    "slug": "falei",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "myapp",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#111212"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.falei.app"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#1A1C1C"
      },
      "package": "com.falei.app"
    },
    "web": {
      "bundler": "metro",
      "output": "static"
    },
    "plugins": [
      "expo-router",
      "expo-font",
			["expo-dev-client", { "launchMode": "most-recent" }]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {
        "origin": false
      },
      "eas": {
        "projectId": "98140829-ce55-4218-8e99-58b502539ec5"
      }
    },
    "owner": "gabrielrsl"
  }
}
